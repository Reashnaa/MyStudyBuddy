<!DOCTYPE html>
<html>
<head>
    <title>Add To-Do Item</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<%- include('partials/navbar') %>

<body class="container mt-5">

    <h1 class="mb-4">Add A To-Do Item</h1>

    <form action="/add-todo" method="POST" class="mb-4">

        <div class="mb-3">
            <label class="form-label">Task</label>
            <input type="text" name="task" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <input type="text" name="description" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label">Deadline Date</label>
            <input type="date" name="deadline" class="form-control">
        </div>

        <button type="submit" class="btn btn-success">Add To-Do</button>
    </form>
        <a href="/" class="btn btn-secondary">
            Cancel - Back to Home
        </a>

        
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>No.</th>
                <th>Task</th>
                <th>Description</th>
                <th>Deadline</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% todos.forEach((todo, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= todo.task %></td>
                    <td><%= todo.description %></td>
                    <td><%= todo.deadline %></td>
                    <td>
                        <a href="/edit/<%= index %>" class="btn btn-sm btn-primary">Edit</a>
                        <a href="/delete/<%= index %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this todo?');">Delete</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</body>
</html>
