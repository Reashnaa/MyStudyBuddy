<!DOCTYPE html> 
<html>

<head>
    <title>Add Study Session</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<%- include('partials/navbar') %> 

<body class="container mt-5"> 

    <h1 class="mb-4">Add A Study Session</h1>

    <form action="/add-session" method="POST"> 

        <div class="mb-3"> 
            <label class="form-label">Subject</label> 

            <input type="text" 
                   name="subject"
                   class="form-control" 
                   required>
        </div>

        <div class="mb-3"> 
            <label class="form-label">Date </label>

            <input type="date"
                   name="date"
                   class="form-control"
                   required>
        </div>

        <div class="mb-3"> 
            <label class="form-label">Duration (minutes)</label>

            <input type="number"
                   name="duration"
                   class="form-control"
                   required>
        </div>

        <div class="mb-3"> 
            <label class="form-label">Notes</label>

            <textarea name="notes"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Add Session
        </button>

        <a 
        href="/" class="btn btn-secondary"> 
        Cancel - Back to Home
        </a>


    </form>

</body>
</html>