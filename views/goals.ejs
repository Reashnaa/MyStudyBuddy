<!DOCTYPE html>
<html>

<head>
    <title>Goals</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<%- include('partials/navbar') %>

<body class="container mt-4">

    <h1>Study Goals</h1>

    <a href="/" class="btn btn-secondary mb-3">
    Back to Home
    </a>

    <a href="/add-goal" class="btn btn-success mb-3">
        Add New Goal
    </a>

    <div class="row">

        <% goals.forEach((g) => { %>

            <div class="col-md-4 mb-3">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title">
                            🎯 <%= g.title %>
                        </h5>

                        <% if (g.featured) { %>
                            <span class="badge bg-warning text-dark mb-2">
                                Featured
                            </span>
                        <% } %>
                        
                        <p>
                            📅 <%= g.targetDate %>
                        </p>

                        <small class="text-muted">
                            <%= g.description %>
                        </small>

                        <br><br>

                        <a href="/edit-goal/<%= g.id %>" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a href="/delete-goal/<%= g.id %>"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                        

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</body>
</html>