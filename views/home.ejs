<!DOCTYPE html> 
<html> 

<head> 
    <title>MyStudyBuddy </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>


<body>

    <nav class="navbar navbar-dark bg-dark"> 
    <div class="container">

        <a class="navbar-brand" href="/">MyStudyBuddy</a>

        <div>
            <a class="nav-link d-inline text-white" href="/sessions"> Sessions </a> <!-- Navigation link for Sessions -->
            <a class="nav-link d-inline text-white" href="/add-todo"> To-Do </a> <!-- Navigation link for To-Do List -->
            <a class="nav-link d-inline text-white" href="/goals"> Goals </a> <!-- Navigation link for Goals -->
        </div>

    </div>
</nav>


    <!-- Main Section -->
    <div class="container text-center mt-5">

        <h1>Welcome to your Study Buddy!</h1>

        <p>Your one stop personalised study buddy that helps you track study sessions, make to do lists, and much more!</p>


    </div>

    <div class="container mt-5"> 
    <div class="row text-center">

        
    <div class="col-md-4 mb-4"> 

        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135755.png" 
        alt="Study Sessions" 
        class="img-fluid mb-3" 
        style="max-height: 120px;">
            
        <h4>Track Sessions</h4>
        <p>Log your daily study sessions and stay consistent.</p>
        
        <a href="/add-session" class="btn btn-primary"> 
            Track A Session Now
        </a>
        
        </div>


        <div class="col-md-4 mb-4">

        <img src="https://cdn-icons-png.flaticon.com/512/942/942748.png"
            alt="To Do List"
            class="img-fluid mb-3"
            style="max-height: 120px;">

            <h4>To do list</h4>
            <p>Create and manage your study tasks and goals.</p>
            <a href="/add-todo" class="btn btn-primary">
                Make/Add to your list now 
            </a>

        </div>

        <div class="col-md-4 mb-4">

        <img src="https://cdn-icons-png.flaticon.com/512/190/190411.png"
            alt="Goals"
            class="img-fluid mb-3"
            style="max-height: 120px;">

            <h4>Stay Motivated by setting goals</h4>
            <p>Set goals and keep your learning journey on track.</p>
            <a href="/add-goal" class="btn btn-primary">
                Set Your Goals
            </a>

        </div>

    </div>
</div>


</body>

</html>