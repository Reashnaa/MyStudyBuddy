<!DOCTYPE html>
<html>

<head> 
    <title>Study Sessions</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<%- include('partials/navbar') %> 

<body class="container mt-4"> 

    <h1>Study Sessions</h1>
    
    <a href="/" class="btn btn-secondary mb-3"> 
    Back to Home
    </a>

    <a href="/add-session" class="btn btn-success mb-3">
    Add New Session
    </a>

    <p>This page will show your study sessions.</p>

    <% if (success) { %> 
    <div class="alert alert-success">
        Session added successfully!
    </div>
    <% } %>


    <!-- Display sessions -->
    <div class="row mt-3">

    <% sessions.forEach((s) => { %>

        <div class="col-md-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h5 class="card-title"> 
                        📘 <%= s.subject %> 
                    </h5>

                    <p>⏱ <%= s.duration %> mins</p>

                    <p>📅 <%= s.date %></p>

                    <small class="text-muted">
                        <%= s.notes %>
                    </small>

                <a href="/edit-session/<%= s.id %>" class="btn btn-warning btn-sm">
                    ✏ Edit
                </a>

                <a href="/delete-session/<%= s.id %>" class="btn btn-danger btn-sm">
                    🗑 Delete
                </a>

                </div>

            </div>

        </div>

    <% }) %>

</div>

</body>
</html>