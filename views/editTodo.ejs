<!DOCTYPE html>
<html>
<head>
    <title>Edit To-Do Item</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<%- include('partials/navbar') %>

<body class="container mt-5">

    <h1 class="mb-4">Edit To-Do Item</h1>

    <form action="/edit/<%= index %>" method="POST">

        <div class="mb-3">
            <label class="form-label">Task</label>
            <input 
                type="text" 
                name="task" 
                value="<%= todo.task %>" 
                class="form-control" 
                required
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <input 
                type="text" 
                name="description" 
                value="<%= todo.description %>" 
                class="form-control"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Deadline Date</label>
            <input 
                type="date" 
                name="deadline" 
                value="<%= todo.deadline %>" 
                class="form-control"
            >
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/add-todo" class="btn btn-secondary ms-2">Cancel</a>

    </form>

</body>
</html>
